# AgentSentry lab configuration
#
# Copy to `.env` and edit. `.env` is read automatically by `docker compose` and
# is git-ignored, so it is the right place for anything machine-specific.
#
# NEVER put a real credential in `.env.example`. The API key lines below are
# intentionally blank; fill them only in your own `.env`, and only if you are
# running the optional LLM planner.

# ---------------------------------------------------------------------------
# Which gateway implementation runs
# ---------------------------------------------------------------------------
# demo_gateway:app  the interim gateway on the target-agent branch (default,
#                   works today)
# gateway.app:app   Caleb's GW-01 gateway, usable once
#                   feature/authorization-gateway is merged, the defects in
#                   docs/integration/gateway-integration-notes.md are fixed,
#                   AND the gateway package sits inside the
#                   services/target-agent build context (see that document)
GATEWAY_MODULE=demo_gateway:app

# ---------------------------------------------------------------------------
# Published host ports (both bind to 127.0.0.1 only)
# ---------------------------------------------------------------------------
# Change these if something else on your machine already uses 8000 or 8501.
AGENT_PORT=8000
DASHBOARD_PORT=8501

# ---------------------------------------------------------------------------
# Target agent planner
# ---------------------------------------------------------------------------
# rule = deterministic baseline. Keep this for Sprint 1: the demo has to be
#        reproducible, and the risk register lists agent nondeterminism as a
#        high-likelihood risk.
# llm  = use a real model as the planner. This sends scenario text to an
#        external provider and makes results non-reproducible. Record it in the
#        scan notes if you use it.
AGENT_PLANNER=rule

# Only read when AGENT_PLANNER=llm. One of: openai, anthropic, ollama.
AGENT_PROVIDER=openai

OPENAI_MODEL=
OPENAI_API_KEY=

ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=

OLLAMA_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
